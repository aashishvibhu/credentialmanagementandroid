<full-backup-content>
    <!-- Exclude Room database from backups (cache only; vault lives in Drive) -->
    <exclude domain="database" path="credential_db" />
    <exclude domain="database" path="credential_db-shm" />
    <exclude domain="database" path="credential_db-wal" />
</full-backup-content>